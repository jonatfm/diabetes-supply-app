  "[javascriptreact]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {},
    "javascript.format.enable": false
  },
  "[json]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "[jsonc]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {},
    "typescript.format.enable": false
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
